# Frontend
VITE_WIDGET_API_BASE_URL=http://localhost:8000
VITE_WIDGET_ID=local-demo

# API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-min
SESSION_TTL_SECONDS=1800
MAX_MANIFEST_BYTES=80000
MAX_AUDIO_SECONDS=30

# LLM Providers (mock / gemini / openai)
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# STT Providers (browser / groq / mock)
STT_PROVIDER=browser
STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=

# TTS Providers (browser / elevenlabs / mock)
TTS_PROVIDER=browser
TTS_MODEL=eleven_turbo_v2
ELEVENLABS_API_KEY=

